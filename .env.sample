# ====================================
# === Infrastructure Configuration ===
# ====================================

# Defines the prefix for networks and volumes
COMPOSE_PROJECT_NAME=dagster_questdb_boilerplate

# ======================================
# === Dagster Resource Configuration ===
# ======================================

# Telemetry coordinates. Replace with your location.
LATITUDE=0
LONGITUDE=0

# QuestDB connection host for the Dagster resource
QDB_HOST=localhost

# =============================
# === QuestDB Configuration ===
# =============================

QDB_PORT=9000
QDB_TELEMETRY_ENABLED=false

# Local-dev credentials. Change before any non-local use.
QDB_PG_USER=admin
QDB_PG_PASSWORD=admin
QDB_PG_READONLY_USER_ENABLED=true
QDB_PG_READONLY_USER=readonly
QDB_PG_READONLY_PASSWORD=readonly
